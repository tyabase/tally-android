# 复制本文件为 keystore.properties，填入你自己的签名信息。
#
#   cp keystore.properties.example keystore.properties
#
# 这个模板之所以要单独存在，是因为真正的 keystore.properties 和 .jks 文件
# 都被 .gitignore 排除了 —— 签名密钥不应该进版本控制，进过一次就永远留在
# 提交历史里，谁都能拿来以你的名义签 APK。
#
# ── 先生成一个属于你自己的密钥库 ────────────────────────────────
#
#   keytool -genkeypair -v \
#     -keystore keystore/tally.jks \
#     -alias tally \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Tally, OU=Personal, O=Personal, L=Shenzhen, ST=Guangdong, C=CN"
#
# keytool 随 JDK 提供，无需额外安装。
# 注意 keyPassword 与 storePassword 在 PKCS12 密钥库中必须相同，
# 否则 apksigner 会报 "Cannot recover key"。
#
# ── 然后填到这里 ──────────────────────────────────────────────

# 密钥库路径，相对于仓库根目录
storeFile=keystore/tally.jks

# 密钥库口令
storePassword=CHANGE_ME

# 密钥别名（生成时 -alias 指定的那个）
keyAlias=tally

# 密钥口令（PKCS12 下与 storePassword 相同）
keyPassword=CHANGE_ME
